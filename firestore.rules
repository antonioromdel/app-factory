rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One installation is one workspace. Every signed-in account of this
    // Firebase project can read and write its data.
    function isSignedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
